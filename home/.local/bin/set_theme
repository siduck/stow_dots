#!/bin/dash

. ~/.config/theme

new_theme=$1

if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    _foot_apply="${new_theme:-$theme}"
    _ftheme="$HOME/.config/themes/foot/$_foot_apply"
    if [ -f "$_ftheme" ]; then
        _fg=$(grep "^foreground=" "$_ftheme" | cut -d= -f2)
        _bg=$(grep "^background=" "$_ftheme" | cut -d= -f2)
        for _pts in /dev/pts/[0-9]*; do
            printf '\033]10;#%s\007\033]11;#%s\007' "$_fg" "$_bg" > "$_pts" 2>/dev/null
            _i=0
            for _c in $(grep -E "^(regular|bright)[0-7]=" "$_ftheme" | cut -d= -f2); do
                printf '\033]4;%d;#%s\007' "$_i" "$_c" > "$_pts" 2>/dev/null
                _i=$((_i + 1))
            done
        done
    fi
fi

if [ -z "$new_theme" ] || { [ "$theme" = "$new_theme" ] && [ -z "$2" ]; }; then
  exit
fi

update_theme() {
  sed -i --follow-symlinks "s/$theme/$new_theme/" "$1"
}

# -------------------------------------- eww  ----------------------------------

update_theme ~/.config/eww/eww.scss
update_theme ~/.config/chadwm/eww/eww.scss
update_theme /home/siduck/.config/hyprdock/eww.scss

# -------------------------------------- gtk theme  ----------------------------------

update_theme ~/.config/xsettingsd/xsettingsd.conf
killall -HUP xsettingsd 2>/dev/null &
update_theme ~/.gtkrc-2.0
update_theme ~/.config/gtk-3.0/settings.ini

# -------------------------------- st & xresources  ----------------------------------

update_theme ~/.Xresources
[ -z "$WAYLAND_DISPLAY" ] && xrdb merge ~/.Xresources

# -------------------------------------- kitty  ----------------------------------

update_theme ~/.config/kitty/kitty.conf
pkill -USR1 kitty 2>/dev/null

# -------------------------------------- alacritty  ----------------------------------

update_theme ~/.config/alacritty/alacritty.toml

# -------------------------------------- foot  ----------------------------------

update_theme ~/.config/foot/foot.ini

if [ -z "$WAYLAND_DISPLAY" ]; then
  win_ids=$(xprop -root _NET_CLIENT_LIST 2>/dev/null | cut -d'#' -f2)
  for id in $win_ids; do
    wm_class=$(xprop -id "$id" WM_CLASS)
    if [ "$wm_class" = 'WM_CLASS(STRING) = "st", "St"' ]; then
      pid=$(xprop -id "$id" | grep -i pid | cut -d'=' -f2 | tr -d ' ')
      kill -USR1 "$pid"
    fi
  done
fi

update_theme ~/.config/nvim/lua/chadrc.lua

_found_nvim=0
for addr in "$XDG_RUNTIME_DIR"/nvim.*; do
    [ -e "$addr" ] || continue
    _found_nvim=1
    nvim --server "$addr" --remote-send ':NvThemeReload <cr>'
done
[ "$_found_nvim" -eq 0 ] && nvim --headless +'NvThemeReload' +qa &

# -------------------------------------- rofi  ----------------------------------

update_theme ~/.config/rofi/config.rasi
update_theme ~/.config/eww/rofi/menu.rasi

# ------------------------------ set wwallpaper ----------------------------------

walldir="/home/$USER/Pictures/walls/"
wallfile=""

case "$1" in
bearded-arc) wallfile="mountain.png" ;;
everblush) wallfile="hills.png" ;;
everforest) wallfile="stairs.jpg" ;;
gruvchad) wallfile="railtrack.jpg" ;;
onenord) wallfile="snow-mountain.jpg" ;;
one_light) wallfile="beach.jpg" ;;
tundra) wallfile="hills.png" ;;
hiberbee) wallfile="silhoutte.png" ;;
chocolate) wallfile="berries.jpg" ;;
scaryforest) wallfile="dronetree.png" ;;
glyph) wallfile="ibm.png" ;;
ayu_dark) wallfile="valley.jpg" ;;
ayu_light) wallfile="white_flowers.jpg" ;;
pastelbeans) wallfile="ocean.jpg" ;;
chadracula-evondev) wallfile="pixel.jpg" ;;
flex-light) wallfile="Tranquility.png" ;;
espresso) wallfile="autumn.jpg" ;;
espresso-light) wallfile="coffee-light2.jpg" ;;
esac

if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    wm_name="Hyprland"
else
    wm_name=$(wmctrl -m 2>/dev/null | awk -F': ' '/Name/ {print $2}')
    feh --bg-fill "$walldir$wallfile"
fi

# # -------------------------------------- openbox ----------------------------------

case "$wm_name" in
  Hyprland)
    update_theme ~/.config/hypr/hyprland.lua
    "$HOME/.config/hyprdock/scripts/update_fuzzel_theme.sh" "$new_theme" 2>/dev/null &
    sed -i "s|^wallpaper=.*|wallpaper=${walldir}${wallfile}|" ~/.config/theme
    killall swaybg 2>/dev/null
    swaybg -i "$walldir$wallfile" -m fill &
    _ftheme="$HOME/.config/themes/foot/$new_theme"
    { printf '[main]\nshell=/home/siduck/.local/bin/foot-session\nfont=JetBrainsMono Nerd Font:size=11.25:style=Medium\npad=20x20 center\n\n[colors-dark]\nalpha=1.0\n'; grep -v '^\[' "$_ftheme"; } > ~/.config/foot/foot.ini
    pkill -x -USR1 foot 2>/dev/null
    gsettings set org.gnome.desktop.interface gtk-theme "$new_theme"
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
    gsettings set org.gnome.desktop.interface cursor-theme 'volantes_cursors'
    ;;

  Openbox)
    update_theme ~/.config/openbox/rc.xml
    openbox --reconfigure
    ;;

  pekwm)
    # pekwm never re-reads Files{Theme} at runtime, so the theme lives at a
    # fixed path and its contents get swapped instead.
    cp ~/.pekwm/themes/"$new_theme"/* ~/.pekwm/themes/current/ 2>/dev/null
    [ -n "$2" ] || pekwm_ctrl -a run Restart
    ;;

  FVWM)
    # ~/.fvwm/current is a symlink into ~/.fvwm/themes/<name>/, so a theme
    # switch is one symlink swap. SIGUSR1 restarts fvwm, which re-reads it.
    ln -sfn themes/"$new_theme" ~/.fvwm/current
    [ -n "$2" ] || pkill -USR1 -x fvwm3
    ;;

  Fluxbox)
    update_theme ~/.fluxbox/init
    fluxbox-remote restart
    ;;

  dwm)
    update_theme ~/.config/chadwm/scripts/bar.sh
    update_theme ~/.config/chadwm/chadwm/config.def.h
		rm -rf ~/.config/chadwm/chadwm/config.h
		cd ~/.config/chadwm/chadwm/ 
   	doas make install && killall bar.sh 2>/dev/null; ~/.config/chadwm/scripts/bar.sh &
    ;;
esac


# # -------------------------------------- shell config ----------------------------------

update_theme ~/.config/theme

[ -z "$HYPRLAND_INSTANCE_SIGNATURE" ] && exec mksh
