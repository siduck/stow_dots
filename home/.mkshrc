nv() {
  [ -n "$1" ] && [ -d "$1" ] && cd "$1" && shift
  nvim +'lua require("nvim-tree.api").tree.open()' "$@"
}

alias rec='ffmpeg -framerate 75 -f x11grab -i $DISPLAY -pix_fmt yuv420p vid.mp4'

# alias rec_high='ffmpeg -framerate 75 -f x11grab -i $DISPLAY -c:v libx264rgb -crf 0 -preset ultrafast -color_range 2 vid.mp4'
alias rec_high='ffmpeg -f x11grab -framerate 75 -i $DISPLAY -vaapi_device /dev/dri/renderD128 -vf "format=nv12,hwupload" -c:v h264_vaapi -qp 24 -color_range 2 vid.mp4'


