bind ^[a=beginning-of-line
bind ^[e=end-of-line
bind ^L=clear-screen

HISTFILE=$HOME/.mksh_history
HISTSIZE=10104096

EDITOR=nvim

. ~/theme
. ~/themes/fzf_themes/$theme

# fzf: tab = complete, ctrl-r = history (both piped through fzf)
# evaluate-region (^[^E) runs the typed function and drops its stdout on the line
__fzf_history() {
  fc -l -r 1 2>/dev/null | awk -F'	' '!s[$2]++' \
    | fzf --no-sort --height '~40%' --nth=2.. --tabstop=6 \
    | sed 's/^ *[0-9]*	//; s/[ 	]*$//'
}

__fzf_complete() {
  typeset stub sel prefix cmd d f IFS i_dir i_file i_cmd
  i_dir=''; i_file=''; i_cmd=''
  # last arg carries a glued __FZFEOL__ sentinel so a trailing space is detectable
  if [ "$#" -gt 0 ]; then eval "stub=\${$#}"; stub="${stub%__FZFEOL__}"; fi
  while [ "$#" -gt 1 ]; do prefix="$prefix$1 "; shift; done
  if [ -z "$prefix" ] && [[ "$stub" != */* ]]; then
    # first word, no slash -> complete commands (aliases, functions, $PATH)
    IFS=:
    sel=$( { alias | sed 's/=.*//'
             typeset +f | grep -v '^__fzf'
             for d in $PATH; do
               for f in "$d"/"$stub"*; do
                 [ -x "$f" ] && [ ! -d "$f" ] && print -r -- "${f##*/}"
               done
             done
           } 2>/dev/null | grep "^$stub" | LC_ALL=C sort -u \
           | sed "s/^/$i_cmd /" | fzf -1 -0 --height '~40%' )
  else
    # everything else -> file/path glob (dir-only for cd/pushd/rmdir)
    cmd="${prefix%% *}"
    typeset -a m mm
    set -A mm -- "$stub"* "$stub".*
    for f in "${mm[@]}"; do
      [ -e "$f" ] || continue                  # drop unmatched glob literals
      case "$f" in */.|*/..|.|..) continue ;; esac   # drop . and ..
      m[${#m[@]}]="$f"
    done
    [ "${#m[@]}" -eq 0 ] && { print -nr -- "$prefix$stub"; return; }
    sel=$(for f in "${m[@]}"; do
            if [ -d "$f" ]; then print -r -- "$i_dir $f"
            else case "$cmd" in cd|pushd|popd|rmdir) ;; *) print -r -- "$i_file $f" ;; esac
            fi
          done | fzf -1 -0 --height '~40%')
  fi
  [ -z "$sel" ] && { print -nr -- "$prefix$stub"; return; }
  sel="${sel#* }"                 # strip leading icon + space
  [ -d "$sel" ] && sel="$sel/"
  print -nr -- "$prefix$sel"
}
bind -m '^R'='^A^K__fzf_history^[^E'
bind -m '^I'='^A__fzf_complete ^E__FZFEOL__^[^E'

alias apps="echo && pacman -Slq | fzf --multi  --preview-window=right,60%  --preview 'pacman -Si {1}' | xargs -ro doas pacman -S"

