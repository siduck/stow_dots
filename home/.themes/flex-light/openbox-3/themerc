# Window title 
window.active.title.bg.color: #f2efe4
window.inactive.title.bg.color: #f2efe4
window.*.label.text.color: #2a2929
window.*.button.*.image.color: #2a2929

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #adaba3
window.inactive.button.max.unpressed.image.color: #adaba3
window.inactive.button.iconify.unpressed.image.color: #adaba3

# Active
window.active.button.close.pressed.image.color: #D14D41
window.active.button.max.pressed.image.color: #879A39
window.active.button.iconify.pressed.image.color: #879A39
window.active.button.max.*.image.color: #879A39
window.active.button.iconify.*.image.color: #DA702C
window.active.button.close.*.image.color: #D14D41
