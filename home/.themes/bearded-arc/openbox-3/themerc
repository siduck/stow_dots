# Window title 
window.active.title.bg.color: #232b3a
window.inactive.title.bg.color: #232b3a
window.*.label.text.color: #c3cfd9
window.*.button.*.image.color: #c3cfd9

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0
# border.color: #ffffff

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #4e5665
window.inactive.button.max.unpressed.image.color: #4e5665
window.inactive.button.iconify.unpressed.image.color: #4e5665

# Active
window.active.button.close.pressed.image.color: #bf616a
window.active.button.max.pressed.image.color: #3CEC85
window.active.button.iconify.pressed.image.color: #3CEC85
window.active.button.max.*.image.color: #3CEC85
window.active.button.iconify.*.image.color: #EACD61
window.active.button.close.*.image.color: #FF738A
