# Window title 
window.active.title.bg.color: #323A40
window.inactive.title.bg.color: #323A40
window.*.label.text.color: #d8caac
window.*.button.*.image.color: #d8caac

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0
# border.color: #ffffff

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
