# Window title
window.active.title.bg.color: #131721
window.inactive.title.bg.color: #131721
window.*.label.text.color: #B3B1AD
window.*.button.*.image.color: #B3B1AD

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors
# Inactive
window.inactive.button.close.unpressed.image.color: #3E4B59
window.inactive.button.max.unpressed.image.color: #3E4B59
window.inactive.button.iconify.unpressed.image.color: #3E4B59

# Active
window.active.button.close.pressed.image.color: #FF3333
window.active.button.max.pressed.image.color: #91B362
window.active.button.iconify.pressed.image.color: #91B362
window.active.button.max.*.image.color: #91B362
window.active.button.iconify.*.image.color: #E6B450
window.active.button.close.*.image.color: #FF3333
