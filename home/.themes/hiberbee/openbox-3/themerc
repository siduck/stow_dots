# Window title 
window.active.title.bg.color: #221f1e
window.inactive.title.bg.color: #221f1e
window.*.label.text.color: #efeeed
window.*.button.*.image.color: #efeeed

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #5a504f
window.inactive.button.max.unpressed.image.color: #5a504f
window.inactive.button.iconify.unpressed.image.color: #5a504f

# Active
window.active.button.close.pressed.image.color: #ff9d85
window.active.button.max.pressed.image.color: #98dd2e
window.active.button.iconify.pressed.image.color: #98dd2e
window.active.button.max.*.image.color: #98dd2e
window.active.button.iconify.*.image.color: #f59762
window.active.button.close.*.image.color: #ff9d85
