# Window title 
window.active.title.bg.color: #1A2130
window.inactive.title.bg.color: #1A2130
window.*.label.text.color: #D1D5DB
window.*.button.*.image.color: #D1D5DB

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #3e4554
window.inactive.button.max.unpressed.image.color: #3e4554
window.inactive.button.iconify.unpressed.image.color: #3e4554

# Active
window.active.button.close.pressed.image.color: #FCA5A5
window.active.button.max.pressed.image.color: #B5E8B0
window.active.button.iconify.pressed.image.color: #B5E8B0
window.active.button.max.*.image.color: #B5E8B0
window.active.button.iconify.*.image.color: #E8D4B0
window.active.button.close.*.image.color: #FCA5A5
