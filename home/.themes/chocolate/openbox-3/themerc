# Window title 
window.active.title.bg.color: #2b2827
window.inactive.title.bg.color: #2b2827
window.*.label.text.color: #beae94
window.*.button.*.image.color: #beae94

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #6b6867
window.inactive.button.max.unpressed.image.color: #6b6867
window.inactive.button.iconify.unpressed.image.color: #6b6867

# Active
window.active.button.close.pressed.image.color: #dc7575
window.active.button.max.pressed.image.color: #95ae92
window.active.button.iconify.pressed.image.color: #95ae92
window.active.button.max.*.image.color: #95ae92
window.active.button.iconify.*.image.color: #e1ba84
window.active.button.close.*.image.color: #dc7575
