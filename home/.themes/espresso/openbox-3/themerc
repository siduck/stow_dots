# Window title
window.active.title.bg.color: #1f1f1f
window.inactive.title.bg.color: #1f1f1f
window.*.label.text.color: #d9d9d9
window.*.button.*.image.color: #d9d9d9

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors
# Inactive
window.inactive.button.close.unpressed.image.color: #575757
window.inactive.button.max.unpressed.image.color: #575757
window.inactive.button.iconify.unpressed.image.color: #575757

# Active
window.active.button.close.pressed.image.color: #ff7575
window.active.button.max.pressed.image.color: #7dc5a2
window.active.button.iconify.pressed.image.color: #7dc5a2
window.active.button.max.*.image.color: #7dc5a2
window.active.button.iconify.*.image.color: #e9a144
window.active.button.close.*.image.color: #ff7575
