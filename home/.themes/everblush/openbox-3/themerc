# Window title
window.active.title.bg.color: #1a2023
window.inactive.title.bg.color: #1a2023
window.*.label.text.color: #dadada
window.*.button.*.image.color: #dadada

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors
# Inactive
window.inactive.button.close.unpressed.image.color: #2d3437
window.inactive.button.max.unpressed.image.color: #2d3437
window.inactive.button.iconify.unpressed.image.color: #2d3437

# Active
window.active.button.close.pressed.image.color: #e57474
window.active.button.max.pressed.image.color: #8ccf7e
window.active.button.iconify.pressed.image.color: #8ccf7e
window.active.button.max.*.image.color: #8ccf7e
window.active.button.iconify.*.image.color: #e5c76b
window.active.button.close.*.image.color: #e57474
