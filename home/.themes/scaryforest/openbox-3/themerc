# Window title 
window.active.title.bg.color: #182724
window.inactive.title.bg.color: #182724
window.*.label.text.color: #e8f0eb
window.*.button.*.image.color: #e8f0eb

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors 
# Inactive
window.inactive.button.close.unpressed.image.color: #5c7068
window.inactive.button.max.unpressed.image.color: #5c7068
window.inactive.button.iconify.unpressed.image.color: #5c7068

# Active
window.active.button.close.pressed.image.color: #ab7d7d
window.active.button.max.pressed.image.color: #78b573
window.active.button.iconify.pressed.image.color: #78b573
window.active.button.max.*.image.color: #78b573
window.active.button.iconify.*.image.color: #d0c191
window.active.button.close.*.image.color: #ab7d7d
