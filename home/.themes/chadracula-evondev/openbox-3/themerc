# Window title
window.active.title.bg.color: #1c1c31
window.inactive.title.bg.color: #1c1c31
window.*.label.text.color: #F8F8F2
window.*.button.*.image.color: #F8F8F2

# Borders
window.handle.width: 0
window.client.padding.width: 0

border.width: 0

# Title
padding.width: 10
padding.height: 8
window.*.title.bg: Solid Flat
window.*.*.bg: Parentrelative
window.label.text.justify: center

# Window btn colors
# Inactive
window.inactive.button.close.unpressed.image.color: #6060a4
window.inactive.button.max.unpressed.image.color: #6060a4
window.inactive.button.iconify.unpressed.image.color: #6060a4

# Active
window.active.button.close.pressed.image.color: #FF5555
window.active.button.max.pressed.image.color: #50FA7B
window.active.button.iconify.pressed.image.color: #50FA7B
window.active.button.max.*.image.color: #50FA7B
window.active.button.iconify.*.image.color: #F1FA8C
window.active.button.close.*.image.color: #FF5555
