(include 'src/left.yuck')
(include 'src/middle.yuck')
(include 'src/right.yuck')

(defwindow dock
           :geometry (geometry :x "0%"
                               :y "-0.5%"
                               :width "90%"
                               :anchor "bottom center")
           ; :reserve (struts ...) is a no-op under dwm -- it ignores _NET_WM_STRUT_PARTIAL,
           ; so the space is reserved in dwm's updatebarpos() via extbarheight instead
           :windowtype "dock"
           :wm-ignore true
  (centerbox  :class "zuup"
    (left)
    (middle)
    (right)))
